<?xml version="1.0"?>
<package format="3">
  <name>sahtd_launch</name>
  <version>0.0.1</version>
  <description>Launch and bringup files for the Security-Aware Human Tracking Drone (GP2).</description>

  <maintainer email="you@example.com">Mohammad</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Run-time dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Because we launch these packages -->
  <exec_depend>sahtd_autonomy</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <export>
    <!-- So launch files are discoverable -->
    <build_type>ament_python</build_type>
  </export>
</package>
