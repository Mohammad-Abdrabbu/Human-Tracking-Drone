# PRODUCTION SECRETS - DO NOT COMMIT TO GIT
# Generate secrets with: openssl rand -hex 32

# JWT Authentication
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ingest API Security (Simulation Connector → VPS)
INGEST_TOKEN=GENERATE_WITH_openssl_rand_hex_32
TAILSCALE_ALLOWED_IPS=100.64.0.0/10

# Database
DATABASE_URL=sqlite:////home/sahtd/app/data/db/sahtd.db

# SAHTD paths (lean deployment)
SAHTD_ROOT=/home/sahtd/app
EVENTS_LOG_PATH=/home/sahtd/app/data/logs/events.jsonl
TELEMETRY_LOG_PATH=/home/sahtd/app/data/logs/telemetry.jsonl
