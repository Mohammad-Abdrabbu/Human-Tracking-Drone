# SAHTD Simulation Connector Environment
# Copy to ~/.config/sahtd/connector.env and edit values

# Source identifier - use "serverA" for main PC, "serverB" for laptop
SAHTD_SOURCE_ID=serverA

# VPS URL - replace with your actual domain
SAHTD_VPS_URL=https://sahtd.yourdomain.com

# Ingest token - must match INGEST_TOKEN on VPS
SAHTD_INGEST_TOKEN=YOUR_INGEST_TOKEN_HERE

# SAHTD repo root path
SAHTD_ROOT=/home/ramadan/sahtd
