[Unit]
Description=SAHTD ROS Graph (perception + follow + geo-guard)
After=sahtd-px4.service
Wants=sahtd-px4.service

[Service]
Type=simple
WorkingDirectory=%h/gp2
Environment=HOME=%h
Environment=SAHTD_ROOT=%h/gp2
ExecStart=%h/gp2/scripts/sahtd_ros.sh
Restart=no
RestartSec=3

[Install]
WantedBy=default.target
