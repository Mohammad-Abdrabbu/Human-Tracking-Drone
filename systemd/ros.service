[Unit]
Description=SAHTD ROS Graph (perception + follow + geo-guard)
After=px4.service
Wants=px4.service

[Service]
Type=simple
WorkingDirectory=%h/sahtd
Environment=HOME=%h
Environment=SAHTD_ROOT=%h/sahtd
ExecStart=%h/sahtd/scripts/core/start_ros.sh
Restart=no
RestartSec=3

[Install]
WantedBy=default.target
