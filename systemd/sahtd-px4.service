[Unit]
Description=SAHTD PX4 SITL + Gazebo (x500_mono_cam)
After=network.target

[Service]
Type=simple
User=ramadan
Environment=HOME=/home/ramadan
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
ExecStart=/home/ramadan/gp2/scripts/sahtd_px4.sh
Restart=no
RestartSec=3

[Install]
WantedBy=default.target
