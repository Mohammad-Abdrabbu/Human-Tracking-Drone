<?xml version="1.0"?>
<sdf version="1.7">
  <actor name="actor_sideways">
    <!-- spawn a little above ground to avoid clipping -->
    <pose>0 0 1.0 0 0 0</pose>

    <skin>
      <!-- use local mesh, not remote URL -->
      <filename>meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walk">
      <!-- same local mesh -->
      <filename>meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

<script>
  <loop>true</loop>
  <delay_start>20.0</delay_start>
  <auto_start>true</auto_start>

  <!-- S1: SIDEWAYS motion - mostly constant X, sweeps left/right in Y -->
  <trajectory id="0" type="walking">
    <!-- Start on left side -->
    <waypoint>
      <time>0.0</time>
      <pose>3.0 -3.0 0.02 0 0 1.5708</pose>  <!-- facing +Y (right) -->
    </waypoint>

    <!-- Sweep to center -->
    <waypoint>
      <time>6.0</time>
      <pose>3.0 0.0 0.02 0 0 1.5708</pose>
    </waypoint>

    <!-- Sweep to right side -->
    <waypoint>
      <time>12.0</time>
      <pose>3.0 3.0 0.02 0 0 1.5708</pose>
    </waypoint>

    <!-- Pause and turn around -->
    <waypoint>
      <time>16.0</time>
      <pose>3.0 3.0 0.02 0 0 -1.5708</pose>  <!-- facing -Y (left) -->
    </waypoint>

    <!-- Sweep back to center -->
    <waypoint>
      <time>22.0</time>
      <pose>3.0 0.0 0.02 0 0 -1.5708</pose>
    </waypoint>

    <!-- Sweep back to left -->
    <waypoint>
      <time>28.0</time>
      <pose>3.0 -3.0 0.02 0 0 -1.5708</pose>
    </waypoint>

    <!-- Turn around for loop -->
    <waypoint>
      <time>32.0</time>
      <pose>3.0 -3.0 0.02 0 0 1.5708</pose>
    </waypoint>
  </trajectory>
</script>

  </actor>
</sdf>
