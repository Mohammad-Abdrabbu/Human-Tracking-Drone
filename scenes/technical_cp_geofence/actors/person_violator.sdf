<?xml version="1.0"?>
<sdf version="1.9">
  <actor name="person_violator">
    <!-- Violator: starts inside playground, walks out after ~15s -->
    <!-- TRIPLED Playground: x=4→28, y=-12→12 (24m x 24m) -->
    <!-- Start at (10, 0), walk towards +X, exit fence at x>28 -->
    <pose>10 0 1.0 0 0 0</pose>

    <skin>
      <filename>model://actor_walk/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walk">
      <filename>model://actor_walk/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <script>
      <loop>true</loop>
      <delay_start>3.0</delay_start>
      <auto_start>true</auto_start>

      <!-- 
           Violator Path (tripled playground):
           - Starts at (10, 0) INSIDE the fence (x=4→28)
           - Walks inside for ~12 seconds
           - Exits fence at x>28 around t=15s
           - Continues outside
           - Loops back (for demo repeatability)
           
           Fence boundary: x=4 (near), x=28 (far), y=-12/+12
      -->

      <trajectory id="0" type="walking">
        
        <!-- ═══ Start inside, facing +X ═══ -->
        <waypoint>
          <time>0.0</time>
          <pose>10 0 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Walk forward inside -->
        <waypoint>
          <time>5.0</time>
          <pose>15 0 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Turn slightly, wander -->
        <waypoint>
          <time>8.0</time>
          <pose>18 -3 0.02 0 0 -0.3</pose>
        </waypoint>
        
        <!-- Continue toward far edge -->
        <waypoint>
          <time>12.0</time>
          <pose>24 -3 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- ═══ EXIT FENCE at t≈15s (x > 28) ═══ -->
        <waypoint>
          <time>15.0</time>
          <pose>30 -3 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Continue walking outside -->
        <waypoint>
          <time>20.0</time>
          <pose>35 -3 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- ═══ Turn around to loop back ═══ -->
        <waypoint>
          <time>22.0</time>
          <pose>35 -3 0.02 0 0 3.14</pose>
        </waypoint>
        
        <!-- Walk back toward fence -->
        <waypoint>
          <time>30.0</time>
          <pose>20 -3 0.02 0 0 3.14</pose>
        </waypoint>
        
        <!-- Turn to face center -->
        <waypoint>
          <time>32.0</time>
          <pose>20 0 0.02 0 0 1.57</pose>
        </waypoint>
        
        <!-- Walk back to start region -->
        <waypoint>
          <time>38.0</time>
          <pose>14 0 0.02 0 0 3.14</pose>
        </waypoint>
        
        <!-- Return to start position -->
        <waypoint>
          <time>42.0</time>
          <pose>10 0 0.02 0 0 0.0</pose>
        </waypoint>
        
      </trajectory>
    </script>
  </actor>
</sdf>
