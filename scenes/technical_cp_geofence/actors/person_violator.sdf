<?xml version="1.0"?>
<sdf version="1.9">
  <actor name="person_violator">
    <!-- Violator: starts 5m from drone, walks straight out slowly -->
    <!-- Fence: x=4→28, y=-12→12 -->
    <!-- SIMPLE STRAIGHT LINE at ~0.5 m/s -->
    <pose>5 0 1.0 0 0 0</pose>

    <skin>
      <filename>model://actor_walk/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walk">
      <filename>model://actor_walk/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <script>
      <loop>true</loop>
      <delay_start>40.0</delay_start>
      <auto_start>true</auto_start>

      <!-- 
           SIMPLE STRAIGHT LINE PATH:
           - Starts at (5, 0), facing +X
           - Walks slowly straight forward (~0.5 m/s)
           - Exits fence at x=28 around t=46s
           - Continues to x=35, then loops back
           
           Speed: ~0.5 m/s (walking pace)
      -->

      <trajectory id="0" type="walking">
        
        <!-- Start at (5, 0) -->
        <waypoint>
          <time>0.0</time>
          <pose>5 0 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Walk straight to x=28 (exit fence) - 23m at 0.5m/s = 46s -->
        <waypoint>
          <time>46.0</time>
          <pose>28 0 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Continue outside to x=35 -->
        <waypoint>
          <time>60.0</time>
          <pose>35 0 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Turn around -->
        <waypoint>
          <time>62.0</time>
          <pose>35 0 0.02 0 0 3.14</pose>
        </waypoint>
        
        <!-- Walk back to start -->
        <waypoint>
          <time>122.0</time>
          <pose>5 0 0.02 0 0 3.14</pose>
        </waypoint>
        
        <!-- Turn to face forward again -->
        <waypoint>
          <time>124.0</time>
          <pose>5 0 0.02 0 0 0.0</pose>
        </waypoint>
        
      </trajectory>
    </script>
  </actor>
</sdf>
