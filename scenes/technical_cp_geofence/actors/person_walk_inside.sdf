<?xml version="1.0"?>
<sdf version="1.9">
  <actor name="person_walk_inside">
    <!-- Walking actor - stays inside fence, shifted right -->
    <!-- Fence: x=4→28, y=-12→12 -->
    <pose>16 -4 1.0 0 0 0</pose>

    <skin>
      <filename>model://actor_walk/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walk">
      <filename>model://actor_walk/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

    <script>
      <loop>true</loop>
      <delay_start>5.0</delay_start>
      <auto_start>true</auto_start>

      <!-- Small rectangle inside fence, on the right side -->
      <trajectory id="0" type="walking">
        
        <waypoint>
          <time>0.0</time>
          <pose>16 -4 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Walk +X -->
        <waypoint>
          <time>5.0</time>
          <pose>22 -4 0.02 0 0 0.0</pose>
        </waypoint>
        
        <!-- Turn down (-Y) -->
        <waypoint>
          <time>6.0</time>
          <pose>22 -4 0.02 0 0 -1.57</pose>
        </waypoint>
        <waypoint>
          <time>10.0</time>
          <pose>22 -8 0.02 0 0 -1.57</pose>
        </waypoint>
        
        <!-- Turn -X -->
        <waypoint>
          <time>11.0</time>
          <pose>22 -8 0.02 0 0 3.14</pose>
        </waypoint>
        <waypoint>
          <time>16.0</time>
          <pose>16 -8 0.02 0 0 3.14</pose>
        </waypoint>
        
        <!-- Turn +Y -->
        <waypoint>
          <time>17.0</time>
          <pose>16 -8 0.02 0 0 1.57</pose>
        </waypoint>
        <waypoint>
          <time>21.0</time>
          <pose>16 -4 0.02 0 0 1.57</pose>
        </waypoint>
        
        <!-- Turn +X to loop -->
        <waypoint>
          <time>22.0</time>
          <pose>16 -4 0.02 0 0 0.0</pose>
        </waypoint>
        
      </trajectory>
    </script>
  </actor>
</sdf>
