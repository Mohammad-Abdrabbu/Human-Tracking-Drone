# SAHTD Frontend Environment Variables
# Copy this file to .env.local and update with your LAN IP
# DO NOT commit .env.local with real values

# API base URL (FastAPI backend)
VITE_API_BASE_URL=http://<192.168.1.3>:8000

# WebSocket base URL (FastAPI backend)
VITE_WS_BASE_URL=ws://<192.168.1.3>:8000
