# SAHTD Frontend Environment Variables
# Copy this file to .env.local and update as needed.
# DO NOT commit .env.local with your actual values.

# For local development (same machine):
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# For LAN access (phone/other device), replace localhost with your LAN IP:
VITE_API_BASE_URL=http://192.168.1.x:8000
VITE_WS_BASE_URL=ws://192.168.1.x:8000
# Tip: Run 'hostname -I | cut -d" " -f1' to get your LAN IP
