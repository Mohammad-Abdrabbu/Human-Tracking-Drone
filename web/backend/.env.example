# SAHTD Backend Environment Variables
# =====================================
# Copy this file to .env and customize as needed.
# DO NOT commit .env with production secrets!

# JWT Configuration
# -----------------
# Secret key for signing JWT tokens (CHANGE THIS in production!)
JWT_SECRET_KEY=change-me-in-production

# JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Token expiration in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Path Configuration (Optional)
# -----------------------------
# These paths are auto-detected from the repository structure.
# Only set them if you need to override the defaults.

# Events log file (JSONL format)
# Default: $SAHTD_ROOT/data/logs/events.jsonl
# EVENTS_LOG_PATH=/path/to/events.jsonl

# Telemetry log file (written by ROS telemetry_bridge_node)
# Default: $SAHTD_ROOT/data/logs/telemetry.jsonl
# TELEMETRY_LOG_PATH=/path/to/telemetry.jsonl

# Geo-fence configuration YAML
# Default: $SAHTD_ROOT/ros2/src/sahtd_launch/config/geo_guard.yaml
# FENCE_YAML_PATH=/path/to/geo_guard.yaml

# Database Configuration (Optional)
# ----------------------------------
# Database directory (SQLite database will be created here)
# Default: $SAHTD_ROOT/data/db
# SAHTD_DB_DIR=/path/to/db

# User Seeding (for init_db.py --seed)
# -------------------------------------
# Override default demo users when seeding the database.
# Only used by scripts/init_db.py --seed

# Operator account (has full access to all commands and user management)
# SAHTD_OPERATOR_EMAIL=operator@uop.edu.jo
# SAHTD_OPERATOR_PASSWORD=secret123

# Viewer account (has read-only access to telemetry and alerts)
# SAHTD_VIEWER_EMAIL=viewer@uop.edu.jo
# SAHTD_VIEWER_PASSWORD=viewer123
