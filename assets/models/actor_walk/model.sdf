<?xml version="1.0"?>
<sdf version="1.7">
  <actor name="actor_walk">
    <!-- spawn a little above ground to avoid clipping -->
    <pose>0 0 1.0 0 0 0</pose>

    <skin>
      <!-- use local mesh, not remote URL -->
      <filename>meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <animation name="walk">
      <!-- same local mesh -->
      <filename>meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>

<script>
  <loop>true</loop>
  <delay_start>40.0</delay_start>
  <auto_start>true</auto_start>

  <!-- Start ~3 m ahead, walk +X, small right (−Y) bend, left back, then straight -->
  <trajectory id="0" type="walking">
    <!-- Start at x=3, y=0 facing +X -->
    <waypoint>
      <time>0.0</time>
      <pose>3 0 0.02 0 0 0.0</pose>
    </waypoint>

    <!-- Straight +X (~1 m/s) -->
    <waypoint>
      <time>5.0</time>
      <pose>8 0 0.02 0 0 0.0</pose>
    </waypoint>

    <!-- Gentle RIGHT bend (toward −Y) -->
    <waypoint>
      <time>10.0</time>
      <pose>13 -1.0 0.02 0 0 -0.35</pose>  <!-- ~−20° -->
    </waypoint>
    <waypoint>
      <time>15.0</time>
      <pose>18 -2.0 0.02 0 0 -0.79</pose>  <!-- ~−45° -->
    </waypoint>
    <waypoint>
      <time>20.0</time>
      <pose>23 -1.0 0.02 0 0 -0.35</pose>
    </waypoint>

    <!-- Left back to centerline (yaw → 0) -->
    <waypoint>
      <time>25.0</time>
      <pose>28 0.0 0.02 0 0 -0.10</pose>
    </waypoint>
    <waypoint>
      <time>30.0</time>
      <pose>33 0.0 0.02 0 0 0.0</pose>
    </waypoint>

    <!-- Continue straight +X -->
    <waypoint>
      <time>40.0</time>
      <pose>43 0.0 0.02 0 0 0.0</pose>
    </waypoint>
  </trajectory>
</script>

  </actor>
</sdf>
